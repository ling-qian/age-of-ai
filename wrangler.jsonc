{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "age-of-ai-cloud",
  "main": "cloudflare/worker/src/index.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "GameContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_CONTAINER",
        "class_name": "GameContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameContainer"]
    }
  ],
  "exports": {
    "GameContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
